# ---- Supabase (same project as web/ and mobile/) ----
NEXT_PUBLIC_SUPABASE_URL=            # Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase → Settings → API → anon public key

# ---- Maps ----
# No token needed: maps render with MapLibre on free OpenStreetMap tiles
# (lib/osm.ts). Pickup pins come from server-side Mapbox geocoding.

# ---- Web Push (VAPID) ----
# Only the PUBLIC half lives here (the applicationServerKey passed to
# pushManager.subscribe). The private half is a JWK-pair JSON read by
# send-push from the VAPID_KEYS edge secret or, if unset, the service-role-only
# app_secrets table — the Next app never sees it. WEB_PUSH_CONTACT likewise.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
