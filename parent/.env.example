# ---- Supabase (same project as web/ and mobile/) ----
NEXT_PUBLIC_SUPABASE_URL=            # Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase → Settings → API → anon public key

# ---- Mapbox (live map on the Track screen) ----
# Public token — safe to expose. Same token family as the mobile app's
# EXPO_PUBLIC_MAPBOX_TOKEN. Without it, the Track screen shows the stylised
# fallback map instead of a live Mapbox map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- Web Push (VAPID) ----
# Generate once with:  npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address embedded in push subscriptions (mailto: or https:)
WEB_PUSH_CONTACT=mailto:hello@busbuzz.ng
