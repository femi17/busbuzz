{
  "cli": {
    "version": ">= 20.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "driver": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "driver" }
    },
    "driver-prod": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "driver" }
    }
  },
  "submit": {
    "production": {}
  }
}
